# Copy to .env and fill in secrets. .env is gitignored.
# Everything marked REQUIRED must be set before the app will start in prod.

# ============================================================================
# Django core
# ============================================================================
# REQUIRED: generate with `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=
# false in prod, true only on developer machines
DEBUG=false
# Comma-separated. Include your domain + healthcheck host.
ALLOWED_HOSTS=avtohelp24.ru,localhost,127.0.0.1
# Comma-separated origins allowed to call the API from a browser (web admin etc.).
# Leave empty to disallow all browser origins — Android app doesn't use CORS.
CORS_ALLOWED_ORIGINS=
# Settings module: dev | prod | test
DJANGO_SETTINGS_MODULE=roadhelpbackend.settings.prod

# ============================================================================
# Database (PostgreSQL + PostGIS)
# ============================================================================
DB_NAME=roadhelp
DB_USER=roadhelp
# REQUIRED
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# ============================================================================
# Redis (cache, Celery broker, Channels layer)
# ============================================================================
REDIS_URL=redis
REDIS_PORT=6379
REDIS_DB=0

# ============================================================================
# Localization
# ============================================================================
TIME_ZONE=Europe/Moscow
USE_TZ=true
USE_I18N=true

# ============================================================================
# Celery
# ============================================================================
USE_CELERY=true

# ============================================================================
# Sentry (observability) — leave empty in dev
# ============================================================================
SENTRY_DSN=

# ============================================================================
# SMS via SMSC.ru
# ============================================================================
SMS_SERVICE=https://smsc.ru/sys/send.php
SMS_LOGIN=
SMS_PASSWORD=
SMS_SENDER=RoadHelper
# false = do NOT send real SMS (dev); true = actually call SMSC
USE_SMS=false
# When true, accept code "12345" for any phone (dev only). MUST be false in prod.
TEST_SMS_CODE=false
# Admin phone that can always log in (for QA). Set to empty "" to disable.
APPROVE_ACCOUNT=

# SMS tuning
SMS_SEND_DELAY=60
SMS_CODE_LENGTH=5
SMS_INPUT_ATTEMPTS=2
SMS_BLOCKING_PERIOD=86400

# ============================================================================
# OTP (voice-call code) via new-tel.net
# ============================================================================
OTP_SERVICE=https://api.new-tel.net
OTP_SERVER_KEY=
OTP_SIGNATURE_KEY=

# ============================================================================
# Firebase Cloud Messaging (push to Android)
# fcm-django 2.x uses firebase-admin SDK with a service account JSON (NOT the legacy server key).
# Place the JSON file on the server and point here.
# ============================================================================
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/fcm-service-account.json

# ============================================================================
# Business rules
# ============================================================================
# Minutes until an assistance request expires
REQUEST_RELEVANCE=30
# Radius (meters) to show nearby requests
DEFAULT_REQUEST_RADIUS=100000
# Chat
NOTIFY_USERS_ON_ENTER_OR_LEAVE_ROOMS=true
LIMIT_UNREAD_MESSAGES=3
MESSAGES_UPDATE_PERIOD=15
# ID of a user that receives system newsletters (set to a real superuser id)
NEWSLETTER_USERPROFILE_ID=1

# ============================================================================
# DRF
# ============================================================================
PAGE_SIZE=15

# ============================================================================
# Uploads
# ============================================================================
DATA_UPLOAD_MAX_MEMORY_SIZE=104857600

# ============================================================================
# Rate limiting (requests per period). Applied to /authorization/verify and /auth.
# ============================================================================
RATELIMIT_AUTH_PER_IP=5/m
RATELIMIT_AUTH_PER_PHONE=3/h
